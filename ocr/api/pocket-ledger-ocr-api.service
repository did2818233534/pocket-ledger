[Unit]
Description=Pocket Ledger OCR API gateway
After=network-online.target docker.service

[Service]
User=did
Group=did
WorkingDirectory=/opt/pocket-ledger-ocr-api
EnvironmentFile=/opt/pocket-ledger-ocr-api/service.env
ExecStart=/usr/bin/python3 /opt/pocket-ledger-ocr-api/gateway.py serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pocket-ledger-ocr-api/data
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
